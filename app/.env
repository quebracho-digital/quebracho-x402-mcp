# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> x402 ###
# Demo defaults: Base Sepolia. PAY_TO is the author's Ombú testnet wallet (the buyer in ombu/scripts/.env); override it in .env.local.
# Seller on a mainnet: set X402_NETWORK and X402_PAY_TO in .env.local. Buyer on a mainnet: X402_BUDGETS, X402_PAYTO_ALLOW and a non-public X402_BUYER_KEY there too.
X402_NETWORK=eip155:84532
X402_PRICE=0.01
X402_PAY_TO=0xcb2d7f50D917FeD02b82ef08cEfBF9827463B794
X402_PAID_TOOLS=wisdom,analyze_terms
# Tools whose answers the payment ledger never keeps (a retry gets already_settled, not the answer). Comma separated, empty: none.
X402_SENSITIVE_TOOLS=
# A tool's own price in USD, when it is not X402_PRICE: the Hugging Face call behind analyze_terms costs more than a cent.
X402_PRICES='{"analyze_terms":"0.02"}'
# A tool's own maxTimeoutSeconds (default 60), and its worst case in seconds from the claim to the settle:
# a signature with less time left (plus 6 s) is refused before the claim. analyze_terms: 40 s Hugging Face + 20 s for the settle.
X402_TIMEOUTS='{"analyze_terms":120}'
X402_DURATIONS='{"analyze_terms":60}'
# "mock" (signatures verified, nothing settled) or a facilitator URL (https://x402.org/facilitator on testnet).
X402_FACILITATOR=mock
# Chainalysis sanctions API key; empty = OFAC's list, ours and the token's (app:screening).
X402_SCREENING_API_KEY=
# Seconds an API answer is kept, clean or sanctioned (86400 = a day).
X402_SCREENING_CACHE_TTL=86400
# Seconds to wait for the API, and what no answer means: reject or allow.
X402_SCREENING_TIMEOUT=3
X402_SCREENING_UNAVAILABLE=reject
###< x402 ###

###> app:ask ###
# The agent's LLM: any OpenAI-compatible server. Real values go in .env.local.
LLM_BASE_URL=http://localhost:8080
LLM_MODEL=local
LLM_API_KEY=none
# Hugging Face Inference Providers, for `app:ask --hf`: your token, in .env.local. Any chat model with tool calling.
HF_TOKEN=
HF_MODEL=openai/gpt-oss-20b
# The model behind analyze_terms (SUPER BETA example): open weights on Inference Providers; needs HF_TOKEN.
TERMS_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
# Reverse proxies whose X-Forwarded-For we believe (comma separated, or private_ranges). In production list the real ones (see README).
TRUSTED_PROXIES=private_ranges
# POST /mcp requests per minute, per client (IPv6 by /64) and for the whole server; over either: 429, before any signature is checked.
MCP_LIMIT_IP=60
MCP_LIMIT_GLOBAL=600
# analyze_terms calls per client IP per hour (paid calls only; over it: 429, before the payment is verified) and in total per day
# (Hugging Face credit; over it: a tool error). Nothing is charged either way.
TERMS_LIMIT_IP=5
TERMS_LIMIT_DAY=500
# A POST to /mcp larger than this is refused with 413 before it is parsed (McpBodyLimit).
MCP_MAX_BODY_BYTES=131072
MCP_URL=https://quebracho-x402-mcp.ddev.site/mcp
OMBU_MCP_URL=https://ombu.quebracho.digital/mcp
# Buyer key: the PUBLIC example key from the web3.js docs (secret scanners flag it: false positive).
# Anyone can spend what it holds, so it is for the testnet demo. Your own keys go in .env.local.
X402_BUYER_KEY=0x4c0883a69102937d6231471b5dbb6204fe5129617082792ae468d01a3f362318
# Buyer limits (app:ask), per run, in USD, JSON by network. A network not listed is never paid.
# Arc mainnet (eip155:5042) is NOT listed on purpose: add it in .env.local with a non-public buyer key.
X402_BUDGETS='{"eip155:84532":"0.05"}'
# Ceiling for one single payment, same shape.
X402_MAX_PER_PAYMENT='{"eip155:84532":"0.02"}'
# Longest validity (seconds) the buyer signs; keep it under the 180 s the paying client waits for an answer.
X402_BUYER_MAX_TIMEOUT=170
# Wallets the buyer may pay (comma separated, default deny). Add a seller's payTo to buy from it.
# If you change X402_PAY_TO in .env.local, change this too, or app:ask refuses your own server.
X402_PAYTO_ALLOW=0xcb2d7f50D917FeD02b82ef08cEfBF9827463B794
###< app:ask ###


###> symfony/lock ###
# Choose one of the stores below
# postgresql+advisory://db_user:db_password@localhost/db_name
LOCK_DSN=flock
###< symfony/lock ###

# Job mode (analyze_terms_start): at most this many jobs work at once; a _start beyond it is refused before its deposit settles.
JOB_SLOTS=2
